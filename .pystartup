if False:
    import tensorflow as tf
    import tensorflow_probability as tfp

    def create_virtual_devices(
        num_devices: int, device: Optional[tf.config.PhysicalDevice] = None
    ) -> None:
        if device is None:
            physical_devices = tf.config.experimental.list_physical_devices()
            device = physical_devices[0]
        return tf.config.experimental.set_virtual_device_configuration(
            device, [tf.config.experimental.VirtualDeviceConfiguration()] * num_devices
        )

    create_virtual_devices(5)
    tf.random.set_seed(42)


