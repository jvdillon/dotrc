## Array functions (pass array by reference, length as parameter)
## Global array arr_[] with length narr_; use arr1-arr20 helpers to fill

# Fill a[0..n-1] with start, start+step, start+2*step, ...
define arange(*a__[], n, start, step) {
    auto i
    for (i = 0; i < n; i++) a__[i] = start + i * step
    return n
}

# Print array elements
define aprint(*a__[], n) {
    auto i
    for (i = 0; i < n; i++) a__[i]
    return n
}

# L2 norm: sqrt(sum(a[i]^2))
define anorm(*a__[], n) {
    auto i, s
    s = 0
    for (i = 0; i < n; i++) s += a__[i]^2
    return sqrt(s)
}

# Sort array in place (insertion sort)
define asort(*a__[], n) {
    auto i, j, t
    for (i = 1; i < n; i++) {
        t = a__[i]
        j = i
        while (j > 0 && a__[j - 1] > t) {
            a__[j] = a__[j - 1]
            j -= 1
        }
        a__[j] = t
    }
    return 0
}

# Store indices that would sort a[] into idx[]
define aargsort(*idx__[], *a__[], n) {
    auto i, j, t
    for (i = 0; i < n; i++) idx__[i] = i
    for (i = 1; i < n; i++) {
        t = idx__[i]
        j = i
        while (j > 0 && a__[idx__[j - 1]] > a__[t]) {
            idx__[j] = idx__[j - 1]
            j -= 1
        }
        idx__[j] = t
    }
    return 0
}

# Remove consecutive duplicates, return new length
define auniq(*a__[], n) {
    auto i, j
    if (n <= 1) return n
    j = 1
    for (i = 1; i < n; i++) {
        if (a__[i] != a__[j - 1]) {
            a__[j] = a__[i]
            j += 1
        }
    }
    return j
}

# Cumulative sum in place: a[i] = sum(a[0..i])
define acumsum(*a__[], n) {
    auto i
    for (i = 1; i < n; i++) a__[i] += a__[i - 1]
    return 0
}

# Log-sum-exp: log(sum(exp(a[])))
define alogsumexp(*a__[], n) {
    auto i, m, s
    if (n <= 0) return l(0)
    m = a__[0]
    for (i = 1; i < n; i++) {
        if (a__[i] > m) m = a__[i]
    }
    s = 0
    for (i = 0; i < n; i++) s += e(a__[i] - m)
    return m + l(s)
}

# Softmax: p[i] = exp(a[i]) / sum(exp(a[]))
# Result stored back in a__[]
define asoftmax(*a__[], n) {
    auto i, lse
    lse = alogsumexp(a__[], n)
    for (i = 0; i < n; i++) a__[i] = e(a__[i] - lse)
    return 0
}

# Log-softmax: log(p[i]) = a[i] - log(sum(exp(a[])))
# Result stored back in a__[]
define alog_softmax(*a__[], n) {
    auto i, lse
    lse = alogsumexp(a__[], n)
    for (i = 0; i < n; i++) a__[i] -= lse
    return 0
}

# Entropy: -sum(p * log(p)) from log probabilities
define aentropy(*logp__[], n) {
    auto i, s, p
    s = 0
    for (i = 0; i < n; i++) {
        p = e(logp__[i])
        if (p > 0) s -= p * logp__[i]
    }
    return s
}

