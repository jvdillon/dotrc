# True mathematical modulo (result has same sign as y)
define mod(x, y) {
    auto os, r
    os = scale
    scale = 0
    r = x % y
    if (r != 0 && (r < 0) != (y < 0)) r += y
    scale = os
    return r
}

define floor(x) {
    auto os, xx
    os = scale
    scale = 0
    xx = x / 1
    if (xx > x) xx -= 1
    scale = os
    return xx
}

define ceil(x) {
    return -floor(-x)
}

