# Workhorse for pow and log
# Helps determine whether a fractional power is legitimate for negative numbers
# Returns 0 for even/odd; 1 for odd/odd; 2 for odd/even; 3 for irrational
define id_frac_(y) {
    auto os, oib, es, eps, i, cf[], st
    oib = ibase
    ibase = A
    os = scale
    scale = 0
    es = 3 * os / 4
    scale = os
    eps = 10^-es
    y += eps / 10
    scale = es
    y /= 1
    scale = 0
    if (y < 0) y *= -1
    st = y - y / 1
    if (st < eps) {
        y = (y / 1) % 2
        scale = os
        ibase = oib
        return y
    }
    # Determine parity of numerator and denominator of fractional part of y
    # using a finite state machine and continued fraction based construct
    i = 0
    y = st
    while (1) {
        scale = es
        y = 1 / y
        scale = 0
        y -= (cf[i += 1] = y / 1)
        if (i > 100) {
            cf[i = 1] = 3
            break
        }
        if (1.5 * length(cf[i]) > es) {
            cf[i] = 0
            i -= 1
            break
        }
        cf[i] = (cf[i] - 1) % 2 + 1
        if (y == 0) break
    }
    if (i == 0) {
        print "error: id_frac_ internal failure y=", y, "\n"
        scale = os
        ibase = oib
        return 3
    }
    st = cf[i]
    if (st < 3) {
        while (i -= 1) st = (cf[i] * (st + 1)) % 3
    }
    scale = os
    ibase = oib
    return st
}

# Raise x to the y-th power
define pow(x, y) {
    auto os, p, ix, iy, fy, st
    if (y == 0) return 1
    if (x == 0) return 0
    os = scale
    scale = 0
    ix = x / 1
    iy = y / 1
    fy = y - iy
    scale = os
    if (y != iy && x < 0) {
        st = id_frac_(fy)
        if (st == 0) return pow(-x, y)
        if (st == 1) return -pow(-x, y)
        if (st == 2) print "error: pow even root of negative\n"
        if (st == 3) print "error: pow irrational power of negative\n"
        return 0
    }
    if (y == iy) {
        if (x == ix) {
            p = ix^iy
            if (iy > 0) {
                scale = 0
                p /= 1
            }
            scale = os
            return p / 1
        }
        scale *= 2
        p = x^iy
        scale = os
        return p / 1
    }
    p = ix^iy * e(fy / 1 * l(x))
    scale = os * 3
    if (ix) p *= (x / ix)^iy
    scale = os
    return p / 1
}

define expit(x) {
