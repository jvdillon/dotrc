# y-th root of x [x^(1/y)]
define root(x, y) {
    auto os, iy, iz, z, xn
    z = pow(x, 1 / y)
    os = scale
    scale = 0
    if (x == x / 1 && y == (iy = y / 1)) {
        if ((xn = (iz = 1 + z / 1)^iy) == x) {
            scale = os
            return iz
        }
        if ((xn = (iz -= 1)^iy) == x) {
            scale = os
            return iz
        }
    }
    scale = os
    return z
}

# Logarithm of x in given base: logb(2,32) = 5 because 2^5 = 32
define logb(base, x) {
    auto os, i, l, sx, st
    if (base == x) return 1
    if (x == 0) {
        print "error: logb undefined for x=0\n"
        return l(0)
    }
    if (x == 1) return 0
    if (base == 0) {
        print "error: logb undefined for base=0\n"
        return 0
    }
    if (base == 1) {
        print "error: logb undefined for base=1\n"
        return -l(0)
    }
    scale += 6
    if ((-1 < base && base < 0) || (0 < base && base < 1)) {
        x = -logb(1 / base, x)
        scale -= 6
        return x / 1
    }
    if ((-1 < x && x < 0) || (0 < x && x < 1)) {
        x = -logb(base, 1 / x)
        scale -= 6
        return x / 1
    }
    if (base < 0) {
        sx = 1
        if (x < 0) {
            x *= -1
            sx = -1
        }
        l = logb(-base, x)
        st = id_frac_(l)
        if ((st == 0 && sx == 1) || (st == 1 && sx == -1)) {
            scale -= 6
            return l
        }
        if (st <= 1) print "error: logb negative base wrong sign\n"
        if (st == 2) print "error: logb negative base implies even root\n"
        if (st == 3) print "error: logb negative base implies irrational power\n"
        scale -= 6
        return 0
    }
    if (x < 0) {
        print "error: logb undefined for x<0 with positive base\n"
        scale -= 6
        return 0
    }
    x = l(x) / l(base)
    scale -= 6
    return x / 1
}

# Integer-only logarithm of x in given base
define int_logb(base, x) {
    auto os, c
    if (0 < x && x <= 1) {
        return -int_logb(base, 1 / x)
    }
    os = scale
    scale = 0
    base /= 1
    x /= 1
    if (base < 2) base = ibase
    if (x == 0) {
        scale = os
        return 1 - base * A^os
    }
    if (x < base) {
        scale = os
        return 0
    }
    c = -1
    while (x) {
        c += 1
        x /= base
    }
    scale = os
    return c
}

# Lambert's W function 0 branch; numerically solves w*e(w) = x for w
define lambertw0(x) {
    auto oib, a, b, w, ow, lx, ew, eps, iters
    oib = ibase
    ibase = A
    ew = -e(-1)
    if (x < ew) {
        print "error: lambertw0 requires x>=-1/e\n"
        ibase = oib
        return 0
    }
    if (x == ew) {
        ibase = oib
        return -1
    }
    # First approximation from Ringwald and Schrempp via Wikipedia
    if (x < 0) {
        w = x / ew
    } else if (x < 500) {
        lx = l(x + 1)
        w = 0.665 * (1 + 0.0195 * lx) * lx + 0.04
    } else {
        lx = l(x)
        w = l(x - 4) - (1 - 1 / lx) * l(lx)
    }
    # Halley iteration
    ow = 0
    eps = 10^-scale
    scale += 3
    while (abs(ow - w) > eps && w > -1) {
        iters += 1
        ow = w
        ew = e(w)
        a = w * ew
        b = a + ew
        a -= x
        if (a == 0) break
        b = b / a - 1 + 1 / (w + 1)
        w -= 1 / b
        if (x < -0.367) w -= eps
    }
    scale -= 3
    ibase = oib
    return w / 1
}

# Lambert's W function -1 branch; numerically solves w*e(w) = x for w
define lambertw_1(x) {
    auto oib, os, oow, ow, w, ew, eps, iters, total
    oib = ibase
    ibase = A
    ew = -e(-1)
    if (ew > x || x >= 0) {
        print "error: lambertw_1 requires -1/e<=x<0\n"
        ibase = oib
        return 0
    }
    if (x == ew) {
        ibase = oib
        return -1
    }
    os = scale
    eps = 10^-os
    scale += 3
    oow = 0
    ow = 0
    w = x
    w = l(-w)
    w -= l(-w)
    w += sqrt(eps)
    iters = 0
    total = 0
    while (abs(ow - w) > eps) {
        oow = ow
        ow = w
        if (w == -1) break
        w = (x * e(-w) + w^2) / (w + 1)
        iters += 1
        total += 1
        if (total > 500) {
            print "error: lambertw_1 failed to converge\n"
            break
        }
        if (iters == 20 || oow == w) {
            iters = 0
            w -= 10^-scale
            scale += 2
        }
    }
    scale = os
    ibase = oib
    return w / 1
}

# LambertW wrapper; takes most useful branch based on x
define w(x) {
    if (x < 0) return lambertw_1(x)
    return lambertw0(x)
}

# Numerically solve pow(y,y) = x for y
define powroot(x) {
    auto r
    if (x == 0) {
        print "error: powroot undefined for x=0\n"
        return 0
    }
    if (x == 1 || x == -1) {
        return x
    }
    if (x <= r = e(-e(-1))) {
        print "error: powroot unimplemented for x<=e^(-e^-1)\n"
        return 0
    }
    r = l(x)
    r /= w(r)
    return r
}

## Fibonacci

# n-th Fibonacci number over the reals
define fibonacci(n) {
    auto a, b, c, intn, count, fracn, s5, os
    if (n == 0) return 0
    os = scale
    scale = 0
    count = n / 1
    intn = count
    if (n < 0) {
        scale = os
        a = -fibonacci(-n)
        if (n == intn) return a * (-1)^(-intn)
        return a * c(a(1) * 4 * n)
    }
    count += 2
    a = -1
    b = 1
    c = 0
    while (--count) {
        c = a + b
        a = b
        b = c
    }
    scale = os
    if (n == intn) return c
    fracn = n - intn
    s5 = sqrt(5)
    a = e(fracn * l((1 + s5) / 2))
    a *= (s5 * c + sqrt(5 * c^2 + 4 * (-1)^intn)) / 2
    a = (a - c(a(1) * 4 * n) / a) / s5
    return a
}

# Inverse of the above - cannot deal with values below 1 (except 0)
define inverse_fibonacci(f) {
    auto a, b, c, intn, intf, fracf, s5, phinx2, eps, s5f, z5f2, lph, pi, os
    if (f == 0) return f
    if (f < 1) return 0
    os = scale
    scale = 0
    intf = f / 1
    a = -1
    b = 1
    c = 0
    for (intn = -2; c <= intf; intn++) {
        c = a + b
        a = b
        b = c
    }
    scale = os
    if (f == a) return intn
    c = a
    s5 = sqrt(5)
    phinx2 = s5 * c + sqrt(5 * c^2 + 4 * (-1)^intn)
    lph = l((1 + s5) / 2)
    pi = a(1) * 4
    s5f = s5 * f
    z5f2 = 5 * f^2
    a = 0.5
    os += 8
    for (scale = 8; scale <= os; scale += 8) {
        b = 0
        eps = A^(2 - scale)
        while (abs(a - b) > eps) {
            b = a
            a = s5f + sqrt(z5f2 + 4 * c(pi * (intn + a)))
            a /= phinx2
            a = l(a) / lph
        }
        a = (a + b) / 2
    }
    os -= 8
    scale = os
    a /= 1
    return intn + a
}

# n-th Lucas number over the reals
define lucas(n) {
    auto a, b, c, intn, count, fracn, os
    if (n == 0) return 2
    os = scale
    scale = 0
    count = n / 1
    intn = count
    if (n < 0) {
        scale = os
        a = lucas(-n)
        if (n == intn) return a * (-1)^(-intn)
        return a * c(a(1) * 4 * n)
    }
    count += 2
    a = 3
    b = -1
    c = 2
    while (--count) {
        c = a + b
        a = b
        b = c
    }
    scale = os
    if (n == intn) return c
    fracn = n - intn
    a = e(fracn * l((1 + sqrt(5)) / 2))
    a *= (c + sqrt(c^2 - 4 * (-1)^intn)) / 2
    a = a + c(a(1) * 4 * n) / a
    return a
}

# Inverse of the above - inaccurate with values below 2 (except -1, 0, 1)
define inverse_lucas(lv) {
    auto a, b, c, intn, intl, fracl, phinx2, eps, lv2, lph, pi, os
    if (lv < -1) {
        print "error: inverse_lucas unimplemented for lv<-1\n"
        return 0
    }
    if (-1 <= lv && lv < 1) return ((7 - 3 * lv) * lv - A) / (2 * A)
    if (1 <= lv && lv <= 2) return 2 - lv
    os = scale
    scale = 0
    intl = lv / 1
    a = 3
    b = -1
    c = 2
    for (intn = -2; c <= intl; intn++) {
        c = a + b
        a = b
        b = c
    }
    scale = os
    if (lv == a) return intn
    c = a
    phinx2 = c + sqrt(c^2 - 4 * (-1)^intn)
    lph = l((1 + sqrt(5)) / 2)
    pi = a(1) * 4
    lv2 = lv^2
    a = 0.5
    os += 8
    for (scale = 8; scale <= os; scale += 8) {
        b = 0
        eps = A^(2 - scale)
        while (abs(a - b) > eps) {
            b = a
            a = lv + sqrt(lv2 - 4 * c(pi * (intn + a)))
            a /= phinx2
            a = l(a) / lph
        }
    }
    os -= 8
    scale = os
    a /= 1
    return intn + a
}

## Factorials

# Gosper's approximation to the natural log of x!
define gosper(x) {
    auto os, s, intx, pi
    pi = 4 * a(1)
    if (x == 0) return 0
    if (x < 0) {
        os = scale
        scale = 0
        intx = x / 1
        scale = os
        if (x == intx) return (-1)^x * A^scale
        x *= -1
        pi *= x
        s = s(pi)
        if (s <= 0) return 1 - A^scale
        return l(pi) - l(s) - gosper(x)
    }
    return x * (l(x) - 1) + (l(2 * x + 1 / 3) + l(pi)) / 2
}

# Gosper's approximation to n!
define gfactorial(n) {
    return ceil(e(gosper(n)))
}

# Nemes' approximation to the natural log of x!
define nemes(x) {
    auto os, s, lx, intx, pix
    pix = 4 * a(1) * x
    if (x == 0) return 0
    if (x < 0) {
        os = scale
        scale = 0
        intx = x / 1
        scale = os
        if (x == intx) return (-1)^x * A^scale
        x *= -1
        pix *= -1
        s = s(pix)
        if (s <= 0) return 1 - A^scale
        return l(pix) - l(s) - nemes(x)
    }
    lx = l(x)
    # C=12 in bc's hex notation
    s = x * (lx - 1) + l(2 * pix) / 2 + 1 / (C * x + 2 / (5 * x + (5 * A + 3) / (4 * A + 2) / x))
    s -= e(-7 * (9 / 8 + lx))
    return s
}

# Nemes' approximation to n!
define nemfactorial(n) {
    return e(nemes(n))
}

# x! - approximation to the factorial function over the reals
define factorial(x) {
    auto i, xx, x2, xx2, k, a, b, na, nb, os, oib
    if (x == 0 || x == 1) return 1
    oib = ibase
    ibase = A
    if (x == 0.5) {
        ibase = oib
        return sqrt(a(1))
    }
    if (0 < x && x < 1) {
        x += 1
        return factorial(x) / x
    }
    os = scale
    scale = 0
    xx = x / 1
    scale = os
    if (x < 0) {
        if (x == xx) {
            print "error: factorial undefined for negative integers\n"
            return 0
        }
        x = -x
        a = pi * x
        ibase = oib
        return a / s(a) / factorial(x)
    }
    x2 = 2 * x
    os = scale
    scale = 0
    xx2 = x2 / 1
    scale = os
    if (x == xx) {
        xx = 1
        for (i = x; i >= 1; i--) xx *= i
        ibase = oib
        return xx
    } else if (x2 == xx2) {
        x -= .5
        xx = 1
        for (i = x2; i > x; i--) xx *= i
        scale += x
        xx /= 2^(xx2 - 1)
        xx *= sqrt(a(1))
        scale -= x
        ibase = oib
        return xx / 1
    }
    x2 = 2 * (x - xx)
    if (x2 > .5) {
        x2 -= .5
        xx += .5
    }
    xx += 5
    a = factorial(xx)
    na = nemfactorial(xx)
    b = factorial(xx + 0.5)
    nb = nemfactorial(xx + 0.5)
    k = na / a
    k += (nb / b - k) * x2
    xx = nemfactorial(x + 5) / (k * (x + 5) * (x + 4) * (x + 3) * (x + 2) * (x + 1))
    ibase = oib
    return xx
}

# Logarithm of the above
define logfactorial(x) {
    auto i, xx, x2, xx2, k, a, b, na, nb, os, oib
    if (x == 0 || x == 1) return 0
    oib = ibase
    ibase = A
    if (x == 0.5) {
        ibase = oib
        return l(a(1)) / 2
    }
    if (x <= 2470) {
        ibase = oib
        return l(factorial(x))
    }
    if (0 < x && x < 1) {
        x += 1
        return logfactorial(x) - l(x)
    }
    os = scale
    scale = 0
    xx = x / 1
    scale = os
    if (x < 0) {
        x = -x
        a = a(1) * 4 * x
        ibase = oib
        na = s(a)
        if (na <= 0) return 1 - 10^scale
        return l(a) - l(na) - logfactorial(x)
    }
    x2 = 2 * x
    os = scale
    scale = 0
    xx2 = x2 / 1
    scale = os
    if (x == xx) {
        xx = 0.5 * x * 10^-scale
        for (i = x; i >= 1; i--) xx += l(i)
        ibase = oib
        return xx
    } else if (x2 == xx2) {
        x -= .5
        xx = 0.5 * x * 10^-scale
        for (i = x2; i > x; i--) xx += l(i)
        scale *= 2
        xx -= (xx2 - 1) * l(2)
        xx += 0.5 * l(a(1))
        scale /= 2
        ibase = oib
        return xx / 1
    }
    x2 = 2 * (x - xx)
    if (x2 > .5) {
        x2 -= .5
        xx += .5
    }
    xx += 5
    a = logfactorial(xx)
    na = nemes(xx)
    b = logfactorial(xx + 0.5)
    nb = nemes(xx + 0.5)
    k = na / a
    k += (nb / b - k) * x2
    k = (11 * k - 3) / 8
    xx = (nemes(x + 5) - l(x + 5) - l(x + 4) - l(x + 3) - l(x + 2) - l(x + 1)) / k
    ibase = oib
    return xx
}

# Inverse factorial (approximate) based on derivation by David W. Cantrell
define inverse_factorial(x) {
    auto t, f, eps, os, oib
    if (x == 1 || x == 2) return x
    oib = ibase
    ibase = A
    if (0.89 <= x && x <= 3.9) {
        os = scale
        if (scale > 25) scale = 25
        eps = 10^(5 - scale)
        if (eps > 1) eps = 1
        t = x
        f = x - factorial(t)
        while (abs(f) > eps) {
            t += f / x
            f = x - factorial(t)
        }
        scale = os
        ibase = oib
        return t
    }
    scale += 3
    t = l((x + 0.036534) / sqrt(8 * a(1)))
    t /= lambertw0(t / e(1))
    t -= .5
    scale -= 3
    ibase = oib
    return t / 1
}

# Number of permutations of r items from a group of n (integers only)
define int_permutation(n, r) {
    auto i, p, os
    os = scale
    scale = 0
    n /= 1
    r /= 1
    if (n < 0 || r < 0 || r > n) return 0
    p = 1
    for (i = n; i > n - r; i--) p *= i
    scale = os
    return p
}

define permutation(n, r) {
    return factorial(n) / factorial(n - r)
}

# Number of combinations of r items from a group of n (integers only)
define int_combination(n, r) {
    auto c, os
    os = scale
    scale = 0
    n /= 1
    r /= 1
    if (n < 0 || r < 0 || r > n) return 0
    if (2 * r > n) r = n - r
    c = int_permutation(n, r) / factorial(r)
    scale = os
    return c
}

define combination(n, r) {
    return factorial(n) / factorial(n - r) / factorial(r)
}

# y-th factorial of x: x!_y (integers only)
define int_multifactorial(y, x) {
    auto i, xx, os
    os = scale
    scale = 0
    x /= 1
    y /= 1
    xx = 1
    for (i = x; i >= 1; i -= y) xx *= i
    scale = os
    return xx
}

define semifactorial(x) {
    auto i, xx
    if (x == 0 || x == 1) return 1
    xx = int((x + 1) / 2)
    if (x < 0 && x == xx * 2 - 1) {
        return (-1)^xx * semifactorial(-2 * xx - 1)
    }
    xx = int(x)
    if (x == xx) {
        xx = 1
        for (i = x; i >= 1; i -= 2) xx *= i
        return xx
    }
    x /= 2
    xx = factorial(x)
    x -= .5
    xx *= e(x * l(2))
    xx /= sqrt(a(1))
    return xx
}

## Triangular numbers

define tri(x) {
    auto xx
    x = x * (x + 1) / 2
    xx = int(x)
    if (x == xx) return xx
    return x
}

define trirt(x) {
    auto xx
    x = (sqrt(1 + 8 * x) - 1) / 2
    xx = int(x)
    if (x == xx) x = xx
    return x
}

define tri_step_(t, s) {
    auto tt
    t = t + (1 + s * sqrt(1 + 8 * t)) / 2
    tt = int(t)
    if (tt == t) return tt
    return t
}

define tri_succ(t) {
    return tri_step_(t, 0 + 1)
}

define tri_pred(t) {
    return tri_step_(t, 0 - 1)
}

## Polygonal Numbers

# The xth s-gonal number
define poly(s, x) {
    auto xx
    x *= (s / 2 - 1) * (x - 1) + 1
    xx = int(x)
    if (x == xx) x = xx
    return x
}

# Inverse of the above (polygonal root)
define inverse_poly(s, r) {
    auto t, xx
    t = (s -= 2) - 2
    r = (sqrt(8 * s * r + t^2) + t) / s / 2
    xx = int(r)
    if (r == xx) r = xx
    return r
}

# Converse of poly(); solves poly(s,x)=r for s
define converse_poly(x, r) {
    auto xx
    x = 2 * ((r / x - 1) / (x - 1) + 1)
    xx = int(x)
    if (x == xx) x = xx
    return x
}

## Arithmetic-Geometric mean

define arigeomean(a, b) {
    auto c, eps
    eps = A^-scale
    while (abs(a - b) > eps) {
        c = (a + b) / 2
        a = sqrt(a * b)
        b = c
    }
    return a
}

## Error function and normal distribution

define erf(x) {
    auto s, t, b, n, x2, twonp1, eps
    if (x == 0) return 0
    if (x < 0) return -erf(-x)
    if (x > 6) return 1
    eps = A^-scale
    x2 = x * x
    s = x
    b = x
    t = 0
    n = 0
    twonp1 = 1
    while (abs(s - t) > eps) {
        t = s
        b *= -x2 * twonp1
        n += 1
        twonp1 += 2
        b /= n * twonp1
        s += b
        if (n > 1000) break
    }
    return s * 2 / sqrt(a(1))
}

define erfc(x) {
    return 1 - erf(x)
}

define normcdf(x, m, s) {
    return 0.5 * (1 + erf((x - m) / (s * sqrt(2))))
}

## Numerical integration

# Simpson's rule: caller must define f(x) before calling
define simpson(a, b, n) {
    auto h, sum_even, sum_odd, i
    h = (b - a) / (2 * n)
    sum_even = 0
    sum_odd = 0
    for (i = 1; i <= n; i++) sum_odd += f(a + (2 * i - 1) * h)
    for (i = 1; i < n; i++) sum_even += f(a + 2 * i * h)
    return (f(a) + f(b) + 4 * sum_odd + 2 * sum_even) * h / 3
}

