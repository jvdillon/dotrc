# http://ubuntuforums.org/showthread.php?t=1385485

# Skip the startup copyright notice.
startup_message off

# Dismiss on-screen messages after 1 second.
msgwait 1

# Use an audible bell instead of flashing the screen.
#vbell_msg "beep"
vbell off

# Use Ctrl-x as the command prefix instead of the default Ctrl-a.
escape ^Xx
#escape ~~
#escape ^Bb
#escape ^[[

# Bind Ctrl-x b to copy screen's paste buffer to the system clipboard via xsel.
bind b eval "writebuf" "exec sh -c 'xsel -i -b < /tmp/screen-exchange'"

# Disable alternate screen buffer so output stays in the terminal's native scrollback.
termcapinfo xterm*|xterms|xs|rxvt ti@:te@

# Automatically detach the session when the terminal is closed.
autodetach on

# Let full-screen apps (vim, less) use the alternate screen buffer so they clean up on exit.
# Disabled because it conflicts with ti@:te@ and prevents native mouse scrollback.
#altscreen on

# Enable mouse support within screen's copy mode (click to position cursor, etc).
# Not needed if using ti@:te@ for native scrollback.
#mousetrack on

# Automatically handle flow control (XON/XOFF) for each window.
defflow auto

# Don't block command output if the terminal stops responding (e.g. ssh timeout).
nonblock on

# Keep 50000 lines of scrollback history per window.
defscrollback 50000

# Show a persistent status bar on the last line of the terminal.
hardstatus on
hardstatus alwayslastline
hardstatus string "%{=b}%{G} Screen(s): %{b}%w %=%{kG}%C%A  %D, %M-%d-%Y "
#hardstatus string "%{rw}%H%{wk}|%{wr}%c%{wk}|%d%M|%?%-Lw%?%{wb}%n*%f%t%?(%u)%?%{wk}%?%+Lw%?"
#hardstatus string "%-w%{= BW}%50>%n %t%{-}%+w%<"









#bindkey ^[[5;3~ eval "copy" "stuff \"^u\"" # alt-page-up goes to copy mode
#bindkey ^[[6;3~ eval "copy"  # alt-page-down goes to copy mode
#bindkey -m ^[[5;3~ stuff "^u" # alt-page-up sends page-up in copy mode
#bindkey -m ^[[6;3~ stuff "^d" # alt-page-down sends page-down in copy mode

# http://www.saltycrane.com/blog/2008/01/how-to-scroll-in-gnu-screen/
# If you don't want to hit C-a ESC PGUP everytime to page up, you can create
# keyboard shortcuts. I use CTRL+K to scroll up one line and META+K to scroll
# up one page (I know these are kind of weird key combinations). To create
# these shortcuts, I put the following in my .screenrc.
#bindkey "^[k" eval "copy" "stuff ^b"  # enter copy mode and move up one page
#bindkey "^k" eval "copy" "stuff k"    # enter copy mode and move up one line
#bindkey -m "^[k" stuff ^b             # move up one page
#bindkey -m "^k" stuff k               # move up one line
# Now, when I'm in screen and press M-k, screen enters copy mode and scrolls up
# one page. Likewise, C-k enters copy mode and scrolls up one line. As before,
# to exit copy mode, hit ESC.



# change the hardstatus settings to give an window list at the bottom of the
# screen, with the time and date and with the current window highlighted
#hardstatus string '%{= kG}[ %{G}%H %{g}][%= %{= kw}%?%-Lw%?%{r}(%{W}%n*%f%t%?(%u)%?%{r})%{w}%?%+Lw%?%

#screen -t bash 1


# --- Keybindings

# bind <F7> to detach screen from this terminal
# bind <F8> to kill current session
# bind <F10> to create a new screen
# bind <F9> to rename an existing window
# bind <F11> to move to previous window
# bind <F12> to move to next window
bindkey -k k7 detach
bindkey -k k8 kill
# space in keyboard
bindkey -k k; screen
bindkey -k k9 title
bindkey -k F1 prev
bindkey -k F2 next




