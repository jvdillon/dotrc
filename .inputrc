# ~/.inputrc - readline configuration

# Allow 8-bit characters for international input and output.
set input-meta on
set output-meta on

# Show completions on first tab instead of requiring a second press.
# set show-all-if-ambiguous on

# Show file type indicator (*/@ etc) in completion listings.
set visible-stats on

# Disable the terminal bell.
set bell-style none

# Make tab completion case-insensitive.
set completion-ignore-case on

# Treat hyphens and underscores as equivalent during completion.
set completion-map-case on

# Color completion listings by file type.
set colored-stats on

# Highlight the typed prefix in completion listings.
set colored-completion-prefix on

# Append a slash to symlinked directories in completions.
set mark-symlinked-directories on

# Use bracketed paste so pasted text won't execute until you press enter.
set enable-bracketed-paste on

# Skip over already-completed text when completing in the middle of a word.
set skip-completed-text on

# Disable meta-key conversion to allow 8-bit characters like umlauts.
# set convert-meta off

# Enable the application keypad for systems that need it for arrow keys.
# set enable-keypad on

# Cycle through completions inline with Tab/Shift+Tab instead of listing them.
# TAB: menu-complete
# "\e[Z": menu-complete-backward

# Search history for commands matching the current prefix with Shift+Up/Down.
"\e[1;2A": history-search-backward
"\e[1;2B": history-search-forward

# Bind Delete and Insert to their standard functions across terminals.
"\e[3~": delete-char
"\e[2~": quoted-insert

# Word and line movement keys for xterm, gnome-terminal, and modern terminals.
"\e[1;5C": forward-word
"\e[1;5D": backward-word
"\eOH": beginning-of-line
"\eOF": end-of-line

# Word and line movement keys for the linux console and vt220.
"\e[1~": beginning-of-line
"\e[4~": end-of-line
"\e[5C": forward-word
"\e[5D": backward-word

# Line movement keys for vt100 and FreeBSD console.
"\e[H": beginning-of-line
"\e[F": end-of-line

# Word and line movement keys for rxvt.
"\e[7~": beginning-of-line
"\e[8~": end-of-line
"\eOc": forward-word
"\eOd": backward-word

# Fallback word movement using double-escape sequences.
"\e\e[C": forward-word
"\e\e[D": backward-word
