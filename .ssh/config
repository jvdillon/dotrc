Host *
  Ciphers aes128-gcm@openssh.com
  Compression no
  ControlMaster auto
  ControlPath ~/.ssh/master-%r@%n:%p
  # Kill with: ssh -O exit <host>
  ControlPersist yes
  ForwardX11 yes
  ForwardX11Trusted yes
  Port 22
  ServerAliveInterval 60
  ServerAliveCountMax 3

