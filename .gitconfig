# Note: repo overrides are in <repo>/.git/config
[user]
    name = Joshua V. Dillon
    email = jvdillon@gmail.com
[core]
    editor = vim
[diff]
    tool = vimdiff
[merge]
    tool = vimdiff
[difftool]
    prompt = false
[submodule]
    recurse = true
[push]
    autoSetupRemote = true
[alias]

    # --- Workflow: Step 1 ----------------------------------------------------------
    # New branch from origin/main, pushed and tracked.
    newbranch = "!f() { git fetch origin && git switch -c \"$1\" origin/main && git push -u origin HEAD; }; f"


    # --- Workflow: Step 2 ----------------------------------------------------------
    # Make edits.
    # git config --global alias.ac '!git add -A && git commit -m'
	add-and-commit = !git add -A && git commit -m
    ac = add-and-commit

	add-and-amend = !git add -A && git commit --amend --no-edit
    aa = add-and-update-head

    fixup = "!f() { git commit --fixup=\"${1:-HEAD}\"; }; f"
    f = fixup

    add-and-fixup = !git add -A && git fixup
    af = add-and-fixup

    base-branch = !git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || echo origin/main
    squash = "!base=$(git merge-base HEAD \"$(git base-branch)\") && GIT_SEQUENCE_EDITOR=true git rebase -i --autosquash \"$base\""
    s = squash

    # Squash before first push: git push
    # Squash after branch was pushed: git push --force-with-lease

    update-main = "!git fetch origin && git rebase origin/main"

    # "What will I push?"
    # git config --global alias.pending 'log @{u}..HEAD --stat'
    pending = "!b=$(git base-branch); echo '== unpushed ==' && git log \"$b\"..HEAD --stat --abbrev-commit && echo '== pushed ==' && git log origin/main..\"$b\" --stat --abbrev-commit"
    p = pending

    # Compares: HEAD (last commit) vs working directory
    # Shows: All uncommitted changes (staged + unstaged)
    missing = status -uall --short
    m = missing
    # diff --stat HEAD
    # nothave = status --short

    unstage = reset HEAD --
    last = log -1 HEAD

    # "What will I push?" ("lite")
    # git config --global alias.changes 'diff --stat @{u}..HEAD'
	changes = diff --stat origin/main...HEAD


    # --- Workflow: Step 3 ----------------------------------------------------------
    # Catch up with origin/main, then push.
    # mergemain = !git fetch origin && git merge origin/main
    mergemain = "!f() { git fetch origin || exit 1; zombies=$(git cherry origin/main 2>/dev/null | grep -c '^-' || true); if [ \"$zombies\" -gt 0 ]; then cur=$(git symbolic-ref --short HEAD); echo \"WARNING: $zombies commit(s) on $cur are already in origin/main under different SHAs.\"; echo \"PR was likely squash- or rebase-merged. Suggested cleanup:\"; echo \"  git checkout main && git merge --ff-only origin/main && git branch -D $cur\"; printf 'Continue merge anyway? [y/N] '; read ans; case \"$ans\" in y|Y) ;; *) exit 1 ;; esac; fi; git merge origin/main; }; f"


    # --- Workflow: Step 5 ----------------------------------------------------------
    # Cleanup branch (delete local + remote, return to main).
    deletebranch = "!f() { git switch main && git branch -D \"$1\" && { git push origin --delete \"$1\" 2>/dev/null || true; } && git pull --ff-only; }; f"

    # git config --global alias.expunge-unreachable-now '!git reflog expire --expire-unreachable=now --all && git gc --prune=now'
	expunge-unreachable-now = !git reflog expire --expire-unreachable=now --all && git gc --prune=now

    # https://gist.github.com/robmiller/6018582


    # --- Miscellaneous -------------------------------------------------------------
    # whereami = "!git rev-parse --abbrev-ref HEAD"
    whereami = branch --show-current

    # Fire up your difftool (e.g. Kaleidescope) with all the changes that
    # are on the current branch.
    diffall = difftool origin/main...

[credential "https://github.com"]
    helper =
    helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !/usr/bin/gh auth git-credential
[credential]
    helper = store
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[pull]
    # Refuse to auto-merge or auto-rebase on pull. Forces an explicit choice.
    #
    # We use ff-only to make the safe behavior the default, the destructive
    # behavior explicit.
    #
    # Now git pull refuses non-fast-forward by default. When you genuinely want
    # a merge or rebase, you ask for it explicitly:
    #   git pull --no-ff
    #       Switches off the ff-only restriction; creates a merge commit. Use
    #       when local and remote diverged and you want to integrate via merge
    #       (preserves both branches in history). With pull.ff = only set
    #       globally, plain git pull would refuse on    divergence; --no-ff
    #       says "yes, actually merge them."
    #   git pull --rebase
    #       Abandons merge entirely. Replays your local commits on top of the
    #       fetched tip, producing linear history with no merge commit. The
    #       pull.ff setting is irrelevant because no merge happens.
    #
    #  Example
    #
    #    Local has commit X on top of an old base; remote has commit Y on top
    #    of the same base. After git fetch:
    #
    #             X (local)
    #            /
    #      *----*
    #            \
    #             Y (remote)
    #
    # Three integrations:
    #
    #   1. `git pull` (with pull.ff = only) → refuses. "Not a fast-forward."
    #   2. `git pull --no-ff` → creates merge:
    #
    #              X-----.
    #             /       \
    #       *----*         M (HEAD)
    #             \       /
    #              Y-----'
    #
    #   3. `git pull --rebase` → replays X onto Y:
    #
    #       *----*----Y----X' (HEAD)
    #
    # Pick based on what history shape you want.
    #
    # Most teams prefer --rebase for feature branches (clean linear history)
    # and merges for integrating completed branches into main.
    # git config --global pull.ff only
    ff = only

    # Alternatively,
    # git config --global pull.rebase true
    # rebase = true


# tail -40 ~/.gitconfig

# --- Workflow Example ----------------------------------------------------------
#
# 1. Make a branch from main.
#
#      git newbranch bob/my-thing
#      # git fetch origin && git switch -c bob/my-thing origin/main && git push -u origin HEAD
#
#    Got a collision? Examine then re-push forcefully.
#
#      git log origin/bob/my-thing --oneline -5  # What happened?
#      git push -u origin HEAD --force-with-lease
#
#   If branch exists and you want to nuke it:
#
#      git ls-remote --exit-code origin bob/my-thing && git push origin --delete bob/my-thing
#
#   Note: --force-with-lease refuses if the remote moved since your last fetch,
#         so it can't silently clobber someone else's push.
#
# 2. Make edits as usual.
# 
#      git add . && git commit -m "more stuff" && git push
# 
# 3. Catch up with main before opening PR.
#
#      git mergemain
#      # git fetch origin && git merge origin/main
#
#    If conflicts: edit files to fix, then:
#
#      git add -A && git commit && git push
#
# 
# 4. Open the PR.
#
#      gh pr create --fill --web
#
# 5. Cleanup.
#
#      git deletebranch bob/my-thing
#      # git switch main && git branch -D bob/my-thing && { git push origin --delete bob/my-thing 2>/dev/null || true; }
#      # git pull --ff-only  # sync local main with remote
