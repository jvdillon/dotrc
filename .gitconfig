# Note: repo overrides are in <repo>/.git/config
#
# Workflow assumptions baked into the aliases below:
#
#   1. Single integration branch per repo (origin/HEAD). Doesn't fit gitflow
#      (main + develop) or stacked PRs onto peer feature branches.
#
#   2. origin/HEAD is set on every clone. If it isn't, aliases that resolve
#      it will fail. One-time fix per repo:
#
#          git remote set-head origin -a
[user]
    name = Your Name
    email = your@email.com
[core]
    editor = vim
[diff]
    tool = vimdiff
[merge]
    tool = vimdiff
[difftool]
    prompt = false
[submodule]
    recurse = true
[push]
    # First push of a new branch sets upstream automatically. Belt-and-suspenders
    # with `new-branch` (which already passes -u), but covers branches created
    # by other means (e.g. `git switch -c foo` then `git push`).
    autoSetupRemote = true
[alias]

    # --- Workflow: Step 1 ----------------------------------------------------------
    # New branch from the integration branch, pushed and tracked.
    new-branch = "!f() { \
      git fetch origin && \
      git switch -c \"$1\" origin/HEAD && \
      git push -u origin HEAD; \
    }; f"
    nb = new-branch

    # - Clean branch already equal to integration branch: resets harmlessly/no-op.
    # - Single-commit branch after GH squash merge: resets (patch-id matches).
    # - Multi-commit branch after GH squash merge: REFUSES (per-commit patch-ids
    #   don't match the single squash commit). Use `git delete-branch` instead.
    # - Uncommitted edits: refuses.
    # - New local commits not in integration branch: refuses.
    # - Feature branch before PR merge: refuses.
    refresh-branch = "!f() { \
      git fetch origin || exit 1; \
      if [ -n \"$(git status --porcelain)\" ]; then \
        echo 'Refusing: working tree is not clean'; \
        exit 1; \
      fi; \
      if git cherry origin/HEAD | grep -q '^+'; then \
        echo 'Refusing: branch has commits not in origin/HEAD'; \
        git cherry origin/HEAD; \
        exit 1; \
      fi; \
      git reset --hard origin/HEAD; \
    }; f"
    rb = refresh-branch


    # --- Workflow: Step 2 ----------------------------------------------------------
    # Make edits.
    # Default -m to `git ais` when no message flag is given.
    ai-commit = "!f() { \
        case \" $* \" in \
            *' -m'*|*' --message'*) \
                git commit \"$@\" \
                ;; \
            *) \
                git commit -m \"$(git ais)\" \"$@\" \
                ;; \
        esac; \
    }; f"
    c = ai-commit

    a = add -A

    add-commit = !git a && git c
    ac = add-commit

    amend = commit --amend --no-edit

    # Print an AI-generated summary of a commit vs its parent. Default: HEAD.
    # Requires `sagent` on PATH.
	ai-summary = "!f() { \
	    if [ -z \"$1\" ]; then \
	        target=\"the staged changes (run: git diff --cached)\"; \
	    else \
	        target=\"commit '$1' vs its parent\"; \
	    fi; \
	    prompt=\"Without saying anything else or any other output, briefly summarize ${target} and print a <60 char summary followed by terse bulleted list. Do not list individual file changes unless essential for clarity. Do not list line counts. Avoid overly specific code references. No unicode glyphs. Do not prefix the summary with 'Summary', 'Overall', etc. Be very concise!\"; \
	    echo \"$prompt\" | sagent --model claude-haiku-4-5; \
	}; f"
    ais = ai-summary

    add-amend = !git add -A && git amend
    aa = add-amend

    fixup = "!f() { git commit --fixup=\"${1:-HEAD}\"; }; f"
    f = fixup

    add-fixup = !git add -A && git fixup
    af = add-fixup


    squash = !GIT_SEQUENCE_EDITOR=true git rebase -i --autosquash $(git merge-base HEAD origin/HEAD)
    s = squash
    # Note:
    # - Squash before first push?       git push
    # - Squash after branch was pushed? git push --force-with-lease


    # --- Workflow: Step 3 ----------------------------------------------------------
    # On private branch, before PR / while developing.
    rebase-main = !git fetch origin && git rebase origin/HEAD
    rbm = rebase-main

    # On shared feature branch -- preserves existing commit hashes for collaborators.
    merge-main = !git fetch origin && git merge origin/HEAD
    mm = merge-main


    # --- Workflow: Step 4 ----------------------------------------------------------
    # Open the PR (no alias -- use gh):
    #     gh pr create --fill --web


    # --- Workflow: Step 5 ----------------------------------------------------------
    # Cleanup branch (delete local + remote, return to integration branch).
    # The `|| true` on the remote delete is intentional: GH PR auto-delete
    # often removes the remote branch before we get here, and that's fine.
    delete-branch = "!f() { \
      base=$(git symbolic-ref --short refs/remotes/origin/HEAD); \
      git switch \"${base#origin/}\" && \
      git branch -D \"$1\" && \
      { git push origin --delete \"$1\" 2>/dev/null || true; } && \
      git pull --ff-only; \
    }; f"
    db = delete-branch

    # DANGEROUS: destroys reflog entries for unreachable commits. No undo.
    # Useful to expunge unreachable commits (e.g. after rewriting history,
    # purging a leaked secret, or shrinking a bloated repo).
    # Run only when you're certain you don't need to recover anything.
    nuke-reflog = !git reflog expire --expire-unreachable=now --all && git gc --prune=now


    # --- What's going on? ----------------------------------------------------------
    # Full state of the branch: pushed/unpushed commits + staged/unstaged/untracked
    # files. Sections progress oldest -> newest.
    pending = "!f() { \
      [ -n \"$GIT_PREFIX\" ] && cd \"$GIT_PREFIX\"; \
      export COLUMNS=\"${COLUMNS:-$(tput cols 2>/dev/null || echo 200)}\"; \
      show() { \
        [ -n \"$2\" ] || return 0; \
        n=$((28 - ${#1} - 4)); [ $n -lt 1 ] && n=1; \
        printf '== %s %.*s\\n%s\\n\\n' \"$1\" \"$n\" '==============================' \"$2\"; \
      }; \
      log_range() { \
        range=\"$1\"; shift; \
        git -c diff.statNameWidth=$COLUMNS --no-pager log --color=always --stat --abbrev-commit \"$range\" \"$@\"; \
      }; \
      if u=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null); then \
        unpushed_title='unpushed'; \
        unpushed_range=\"$u..HEAD\"; \
        show 'pushed' \"$(log_range \"origin/HEAD..$u\" \"$@\")\"; \
      else \
        unpushed_title='unpushed (no upstream)'; \
        unpushed_range='origin/HEAD..HEAD'; \
      fi; \
      show \"$unpushed_title\" \"$(log_range \"$unpushed_range\" \"$@\")\"; \
      show 'staged'    \"$(git -c diff.statNameWidth=$COLUMNS --no-pager diff --color=always --cached --stat \"$@\")\"; \
      show 'unstaged'  \"$(git -c diff.statNameWidth=$COLUMNS --no-pager diff --color=always --stat \"$@\")\"; \
      show 'untracked' \"$(git ls-files --others --exclude-standard)\"; \
    }; f"
    p = pending

    # Shows: all uncommitted work -- staged, unstaged, and untracked files.
    missing = status -uall --short
    m = missing
    # `nothave` is an intentional second name -- sometimes "what don't I have
    # committed?" is the natural phrasing.
    nothave = missing

    # Unstage path(s): `git unstage <path>` -- inverse of `git add`.
    unstage = reset HEAD --

    # Show the most recent commit (full message + diff).
    last = log -1 HEAD

    # Lite version of `pending`: just the cumulative diffstat of this branch
    # vs the integration branch. Answers "what will my PR change?"
    changes = diff --stat origin/HEAD...HEAD

    # Print the current branch name (handy in scripts and prompts).
    whereami = branch --show-current

    # Fire up your difftool (e.g. Kaleidescope) with all the changes that
    # are on the current branch.
    diffall = difftool origin/HEAD...


    # --- Quality checks ------------------------------------------------------------
    # `lint` and `typecheck` operate on a NUL-separated file list from
    # `changed-files`. Default scope: branch diff (origin/HEAD...HEAD)
    # plus staged, unstaged, and untracked. Optional commit arg narrows
    # scope to just the files touched by that commit.
    #
    #   git lint                  # everything this branch touches
    #   git lint HEAD             # files in the tip commit
    #   git lint abc123           # files in commit abc123
    #
    # `test` still takes an optional path (changed-file selection for
    # pytest is a footgun -- tests for changed source aren't trivially
    # derivable from filenames).

    # Emit NUL-separated paths. No arg = branch diff + dirty + untracked.
    # With commit = just the files touched by that commit. `--diff-filter=d`
    # drops deletions so the output is always existing-on-disk paths.
    changed-files = "!f() { \
      root=$(git rev-parse --show-toplevel) || return 1; \
      cd \"$root\" || return 1; \
      if [ -n \"$1\" ]; then \
        git diff-tree --no-commit-id --name-only --diff-filter=d -z -r \"$1\"; \
      else \
        { \
          git diff --name-only --diff-filter=d -z origin/HEAD...HEAD ; \
          git diff --name-only --diff-filter=d -z --cached ; \
          git diff --name-only --diff-filter=d -z ; \
          git ls-files -o --exclude-standard -z ; \
        } | sort -zu ; \
      fi ; \
    }; f"
    cf = changed-files

    # Each phase takes an optional path: `git check-lint src/`. Default `.`.
    lint = "!f() { \
      p=\"${1:-.}\"; \
      uv --quiet --project \"$p\" run --frozen ruff check \"$p\" ; \
      uv --quiet --project \"$p\" run --frozen ruff format \"$p\"; \
    }; f"

    typecheck = "!f() { \
      p=\"${1:-.}\"; \
      uv --quiet --project \"$p\" run --frozen ty check \"$p\" ; \
      uv --quiet --project \"$p\" run --frozen basedpyright --threads=6 \"$p\"; \
    }; f"

    test = "!f() { \
      p=\"${1:-.}\"; \
      uv --quiet --project \"$p\" run --frozen pytest \"$p\" -n 4; \
    }; f"

    # Full pipeline. Uses `;` so all phases run even if earlier ones fail
    # (you see every issue, not just the first).
    precommit = "!f() { \
      p=\"${1:-.}\"; \
      git lint \"$p\" ; \
      git typecheck \"$p\" ; \
      git test \"$p\"; \
    }; f"

    uncommit = "!f() { \
      c=\"$1\"; \
      if [ -z \"$c\" ]; then echo 'usage: git uncommit <commit>' >&2; return 2; fi; \
      if [ -n \"$(git status --porcelain)\" ]; then echo 'refusing: working tree is not clean' >&2; return 2; fi; \
      branch=$(git symbolic-ref --short HEAD 2>/dev/null) || { echo 'refusing: not on a branch (detached HEAD)' >&2; return 2; }; \
      p=\"$(mktemp -t git-uncommit.XXXXXX.patch)\" || return 1; \
      git show --format= \"$c\" > \"$p\" || { echo \"failed to write patch: $p\" >&2; return 1; }; \
      git rebase --onto \"$c^\" \"$c\" HEAD || { echo \"rebase failed; patch kept at $p\" >&2; return 1; }; \
      git apply \"$p\" || { echo \"apply failed; patch kept at $p\" >&2; return 1; }; \
      rm -f \"$p\"; \
      git switch -C \"$branch\"; \
    }; f"

[credential "https://github.com"]
    helper =
    helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !/usr/bin/gh auth git-credential
[credential]
    # Persistent plaintext store at ~/.git-credentials. GitHub uses gh above;
    # this covers any other remotes without re-auth prompts.
    # Guard the file: chmod 600 ~/.git-credentials  (verify: ls -l ~/.git-credentials)
    helper = store
    # Safer alternative: in-memory cache (8h), no plaintext on disk. Costs a
    # re-auth prompt every 8h for non-GitHub remotes.
    # helper = cache --timeout=28800
[filter "lfs"]
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
[pull]
    # Refuse to auto-merge or auto-rebase on pull. Forces an explicit choice.
    #
    # We use ff-only to make the safe behavior the default, the destructive
    # behavior explicit.
    #
    # Now git pull refuses non-fast-forward by default. When you genuinely want
    # a merge or rebase, you ask for it explicitly:
    #   git pull --no-ff
    #       Switches off the ff-only restriction; creates a merge commit. Use
    #       when local and remote diverged and you want to integrate via merge
    #       (preserves both branches in history). With pull.ff = only set
    #       globally, plain git pull would refuse on divergence; --no-ff
    #       says "yes, actually merge them."
    #   git pull --rebase
    #       Abandons merge entirely. Replays your local commits on top of the
    #       fetched tip, producing linear history with no merge commit. The
    #       pull.ff setting is irrelevant because no merge happens.
    #
    #  Example
    #
    #    Local has commit X on top of an old base; remote has commit Y on top
    #    of the same base. After git fetch:
    #
    #             X (local)
    #            /
    #      *----*
    #            \
    #             Y (remote)
    #
    # Three integrations:
    #
    #   1. `git pull` (with pull.ff = only) → refuses. "Not a fast-forward."
    #   2. `git pull --no-ff` → creates merge:
    #
    #              X-----.
    #             /       \
    #       *----*         M (HEAD)
    #             \       /
    #              Y-----'
    #
    #   3. `git pull --rebase` → replays X onto Y:
    #
    #       *----*----Y----X' (HEAD)
    #
    # Pick based on what history shape you want.
    #
    # Most teams prefer --rebase for feature branches (clean linear history)
    # and merges for integrating completed branches into main.
    # git config --global pull.ff only
    ff = only

    # Alternatively,
    # git config --global pull.rebase true
    # rebase = true


# Marker: workflow example is the last 48 lines. Quick recap:
# tail -48 ~/.gitconfig

# Suppose you have A---B---C and you want to uncommit B.
# Then:
# git cherry-pick B                             
# git rebase -i B~                              
# drop B, keep the new cherry-pick at the end 
# git reset HEAD^                               


# --- Workflow Example ----------------------------------------------------------
#
# Throughout: "the integration branch" = origin/HEAD (origin/main, origin/master,
# etc.). Set per-repo with: git remote set-head origin -a
#
# 1. Make a branch from the integration branch.
#
#      git new-branch bob/my-thing
#      # git fetch origin && git switch -c bob/my-thing origin/HEAD && git push -u origin HEAD
#
#    Got a collision? Examine then re-push forcefully.
#
#      git log origin/bob/my-thing --oneline -5  # What happened?
#      git push -u origin HEAD --force-with-lease
#
#   If branch exists and you want to nuke it:
#
#      git ls-remote --exit-code origin bob/my-thing && git push origin --delete bob/my-thing
#
#   Note: --force-with-lease refuses if the remote moved since your last fetch,
#         so it can't silently clobber someone else's push.
#
# 2. Make edits as usual.
#
#      git add . && git commit -m "more stuff" && git push
#
# 3. Catch up with the integration branch before opening PR.
#
#      git rebase-main
#      # git fetch origin && git rebase origin/HEAD
#
#    If conflicts: edit files to fix, then:
#
#      git add -A
#      git rebase --continue
#      git push --force-with-lease  # if branch was already pushed
#
#
# 4. Open the PR.
#
#      gh pr create --fill --web
#
# 5. Cleanup.
#
#      git delete-branch bob/my-thing
#      # base=$(git symbolic-ref --short refs/remotes/origin/HEAD)  # usually "origin/main"
#      # git switch "${base#origin/}" && git branch -D bob/my-thing && { git push origin --delete bob/my-thing 2>/dev/null || true; }
#      # git pull --ff-only  # sync local integration branch with remote
